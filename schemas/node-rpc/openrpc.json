  "components": {
    "schemas": {
      "NodeId": {
        "type": "string",
        "pattern": "^[0-9a-hjkmnp-tv-z]{12}$",
        "description": "minted node id, 12 lowercase Crockford characters"
      },
      "MeshId": {
        "type": "string",
        "pattern": "^[0-9a-hjkmnp-tv-z]{12}$"
      },
      "FabricId": {
        "type": "string",
        "pattern": "^[0-9a-hjkmnp-tv-z]{12}$"
      },
      "NodeState": {
        "type": "string",
        "enum": [
          "pending",
          "ready-for-traffic",
          "draining",
          "leaving"
        ]
      },
      "MeshState": {
        "type": "string",
        "enum": [
          "pending",
          "ready-for-traffic",
          "draining",
          "retired"
        ]
      },
      "FabricEvent": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "const": "ready-for-traffic"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "event",
              "initiated_by"
            ],
            "properties": {
              "event": {
                "const": "shutdown-initiated"
              },
              "initiated_by": {
                "$ref": "#/components/schemas/NodeId"
              }
            }
          }
        ]
      },
      "StatusOutcome": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "applied",
              "already-applied",
              "rejected-stale-birth",
              "rejected-not-authority",
              "rejected-invalid-transition",
              "peer-unresolved",
              "not-ready",
              "busy",
              "draining",
              "unauthorized"
            ]
          },
          "held": {
            "type": "string",
            "description": "rejected-stale-birth: what the receiver holds"
          },
          "why": {
            "type": "string",
            "enum": [
              "receiver-not-primary",
              "sender-not-subject",
              "subject-unknown"
            ]
          },
          "needed": {
            "type": "string"
          },
          "sender": {
            "$ref": "#/components/schemas/NodeId"
          },
          "current": {
            "type": "string",
            "description": "rejected-invalid-transition: the state held"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-op-ledger": {
    "description": "The one registry of op codes. A code names a family and its owner; methods register under a code; the fence carries the code and the body the method name. Core = exactly echo and forward. 0x70-0x7F is the testkit range. Retired codes are never reissued.",
    "rows": [
      {
        "op": 17,
        "hex": "0x11",
        "family": "echo",
        "owner": "core",
        "state": "live",
        "methods": [
          "core.echo"
        ]
      },
      {
        "op": 26,
        "hex": "0x1A",
        "family": "forward",
        "owner": "core",
        "state": "live",
        "methods": [
          "core.forward"
        ]
      },
      {
        "op": 27,
        "hex": "0x1B",
        "family": "status",
        "owner": "rdm",
        "state": "live",
        "methods": [
          "rdm.status.declare_node_state",
          "rdm.status.declare_mesh_state",
          "rdm.status.apply_mesh_state",
          "rdm.status.apply_fabric_event"
        ]
      },
      {
        "op": 16,
        "hex": "0x10",
        "family": "legacy-control",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 18,
        "hex": "0x12",
        "family": "data-frame",
        "owner": "rafka",
        "state": "transitional",
        "plane": "data",
        "encoding": "binary",
        "methods": []
      },
      {
        "op": 19,
        "hex": "0x13",
        "family": "snapshot",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 20,
        "hex": "0x14",
        "family": "control",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 21,
        "hex": "0x15",
        "family": "credential-resolve",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 22,
        "hex": "0x16",
        "family": "layout-reprovision",
        "owner": "rafka",
        "state": "retired",
        "methods": []
      },
      {
        "op": 23,
        "hex": "0x17",
        "family": "forward-write",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 24,
        "hex": "0x18",
        "family": "forward-read",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 25,
        "hex": "0x19",
        "family": "peer-tickle",
        "owner": "rafka",
        "state": "transitional",
        "methods": []
      },
      {
        "op": 112,
        "hex": "0x70",
        "family": "proof-store",
        "owner": "testkit",
        "state": "live",
        "methods": [
          "testkit.proof_store.get",
          "testkit.proof_store.put",
          "testkit.proof_store.delete",
          "testkit.proof_store.compare_and_swap"
        ]
      },
      {
        "op": 113,
        "hex": "0x71",
        "family": "resolve-probe",
        "owner": "testkit",
        "state": "live",
        "methods": [
          "testkit.resolve_probe.resolve"
        ]
      },
      {
        "op": 114,
        "hex": "0x72",
        "family": "declare-probe",
        "owner": "testkit",
        "state": "live",
        "methods": [
          "testkit.declare_probe.declare"
        ]
      }
    ]
  }
}