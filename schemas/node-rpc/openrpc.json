{
  "openrpc": "1.3.2",
  "info": {
    "title": "rafka Node RPC",
    "version": "0.1.0",
    "description": "Every call is one QUIC bi-stream: frame 0 the fence (schemas/node-rpc/fence.schema.json), frame 1 the context and this JSON-RPC 2.0 request (invocation.schema.json). The fence's op code names the family a method belongs to; the op ledger (x-op-ledger) is the one registry of codes, owners and methods. Named params only. Every refusal names the receiver and the refused field."
  },
  "methods": [
    {
      "name": "core.echo",
      "summary": "Round-trip a payload; the liveness probe behind every fence check.",
      "x-op": 17,
      "paramStructure": "by-name",
      "params": [
        {
          "name": "payload",
          "required": true,
          "schema": {
            "type": "string",
            "contentEncoding": "base64",
            "maxLength": 87384
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": [
            "payload"
          ],
          "properties": {
            "payload": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        }
      },
      "errors": [
        {
          "code": -32025,
          "message": "stale target"
        },
        {
          "code": -32026,
          "message": "unknown port"
        },
        {
          "code": -32027,
          "message": "unserved op"
        },
        {
          "code": -32028,
          "message": "method not under op"
        }
      ]
    },
    {
      "name": "core.forward",
      "summary": "Carry one invocation to an exact final target this carrier can reach; the inner fence and body travel verbatim and the target's reply comes back verbatim.",
      "x-op": 26,
      "paramStructure": "by-name",
      "params": [
        {
          "name": "target",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/NodeId"
          }
        },
        {
          "name": "inner_fence",
          "required": true,
          "schema": {
            "$ref": "fence.schema.json"
          }
        },
        {
          "name": "inner",
          "required": true,
          "schema": {
            "$ref": "invocation.schema.json"
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "relayed"
              ],
              "properties": {
                "relayed": {
                  "$ref": "invocation.schema.json#/$defs/response"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "inner-not-sent",
                    "inner-indeterminate",
                    "not-forwardable",
                    "peer-unresolved",
                    "not-ready",
                    "busy",
                    "draining"
                  ]
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "errors": [
        {
          "code": -32025,
          "message": "stale target"
        },
        {
          "code": -32026,
          "message": "unknown port"
        },
        {
          "code": -32027,
          "message": "unserved op"
        },
        {
          "code": -32028,
          "message": "method not under op"
        }
      ]
    },
